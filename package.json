{
  "name": "soccer",
  "version": "1.0.0",
  "license": "ISC",
  "author": "Jon Nyman",
  "type": "module",
  "scripts": {
    "test": "tsx --test  $(find src -type f -name '*.test.ts')",
    "e2e": "playwright test",
    "start": "vite",
    "server": "vite build --outDir ../server/public && vite preview --outDir ../server/public",
    "start:full": "concurrently -k -n start,server,api -c blue,green,yellow \"npm:start\" \"npm:server\" \"make -C ../ImageBase dev DATA=data/soccer\"",
    "build": "vite build",
    "build:native": "make -C native build",
    "install:native": "make -C native install",
    "test:native": "make -C native test",
    "check": "tsc --noEmit && tsc -p e2e",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "html-template-tag-stream": "file:../html-template-tag-async",
    "idb-keyval": "^6.2.2",
    "promise-validation": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.6.0",
    "concurrently": "^9.2.1",
    "oxfmt": "^0.35.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^8.3.8"
  }
}
